{
  "name": "@fitfirst/api",
  "version": "0.1.0",
  "private": true,
  "description": "Typed FitFirst API client, generated from the FastAPI OpenAPI schema. Shared by web and mobile.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "gen": "python3 ../../backend/scripts/export_openapi.py && openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "openapi-fetch": "0.17.0" },
  "devDependencies": { "openapi-typescript": "7.13.0", "typescript": "5.9.3" }
}
