{
  "manifest_version": 3,
  "name": "BrewMyJob",
  "version": "0.1.0",
  "description": "Fill company application forms (Workday, Greenhouse, Lever…) from your BrewMyJob profile, on your click. Never submits. Adds LinkedIn, Naukri and Foundit jobs from Google results on your click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://brewmyjob.com/*",
    "https://*.brewmyjob.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BrewMyJob",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.in/search*"
      ],
      "js": [
        "src/google.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
