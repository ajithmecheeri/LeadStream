# Copy to .env (make setup does this). Values here work for local development as-is.

# local | test | prod
ENV=local

# --- Database ---------------------------------------------------------------
# Two roles: the owner runs migrations; the app role is subject to row-level security.
POSTGRES_PASSWORD=postgres
DB_NAME=fitfirst
DB_OWNER=fitfirst
DB_OWNER_PASSWORD=fitfirst
APP_DB_ROLE=fitfirst_app
APP_DB_PASSWORD=fitfirst_app
# Used when you run the API outside Docker (make dev-api). Docker Compose overrides these.
DATABASE_URL=postgresql+asyncpg://fitfirst_app:fitfirst_app@localhost:5432/fitfirst
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://fitfirst:fitfirst@localhost:5432/fitfirst

# --- Auth -------------------------------------------------------------------
# Leave empty locally: a key pair is generated at start-up (you'll be signed in again silently after
# an API restart). Required in prod: run `make keys` and paste the two lines here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# --- App --------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# Alert-forwarding addresses look like alerts-<token>@<INBOUND_DOMAIN>. For real forwarding set it to the
# Email Routing subdomain (in.brewmyjob.com) and the same value in infra/cloudflare/email-worker/wrangler.toml.
INBOUND_DOMAIN=in.fitfirst.local
# Shared secret between the Cloudflare Email Worker and /internal/inbound (HMAC-SHA256).
# Any value works locally (`make inbound` signs with it); for real forwarding run `make email-worker-secret`.
INBOUND_HMAC_SECRET=local-dev-inbound-secret
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels), for `make tunnel`. Leave empty otherwise.
CLOUDFLARE_TUNNEL_TOKEN=
# Load the fictional demo user on API start (Docker only)
SEED_DEMO=true
# Caddy site address: ":80" locally, your domain in prod
SITE_ADDRESS=:80

# --- AI (optional: without keys every AI step uses its rule-based fallback) ----
# ANTHROPIC_API_KEY=          # Claude: reading resumes now; scoring, resume ranking and packs next
# VOYAGE_API_KEY=             # Voyage embeddings: text similarity in match scores
# VOYAGE_TOKENS_PER_RUN=8000   # per scoring run; 8000 fits a free-tier key, raise it once billing is set up
# LLM_DAILY_COST_CAP_USD=1.0  # per user per day, Claude and Voyage together

# --- Later milestones (not used yet) ----------------------------------------
# EXPO_ACCESS_TOKEN=          # M6: mobile push
# SMTP_URL=                   # M6: email notifications

# Milestone 6: WhatsApp alerts for strong matches, through Meta's WhatsApp Business (Cloud) API (docs/plan-m6.md).
# Empty: messages (and verification codes) are written to the worker log instead of sent.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_JOB_TEMPLATE=job_alert      # approved templates in WhatsApp Manager
# WHATSAPP_CODE_TEMPLATE=verify_code
# WHATSAPP_TEMPLATE_LANGUAGE=en

